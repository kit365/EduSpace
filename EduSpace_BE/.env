# =============================================
# EduSpace - AccountService Environment Variables
# Copy this file to .env and fill in actual values
# =============================================

# --- Server ---
SERVER_PORT=8081

# --- Database (PostgreSQL) ---
DB_HOST=your-db-host.com
DB_PORT=5432
DB_NAME=eduspace_account
DB_USERNAME=eduspace
DB_PASSWORD=eduspace

# --- Keycloak OAuth2 (Resource Server / JWT validation) ---
KEYCLOAK_ISSUER_URI=https://your-keycloak.com/realms/eduspace
KEYCLOAK_JWK_SET_URI=https://your-keycloak.com/realms/eduspace/protocol/openid-connect/certs

# --- Keycloak Admin Client (User management API) ---
KEYCLOAK_SERVER_URL=https://your-keycloak.com
KEYCLOAK_REALM=eduspace
KEYCLOAK_CLIENT_ID=eduspace-be
KEYCLOAK_CLIENT_SECRET=your_client_secret_here

# --- Spring Profile ---
SPRING_PROFILES_ACTIVE=dev
