+package com.eduspace.bookingservice.exception;
+
+import lombok.Getter;
+import org.springframework.http.HttpStatus;
+
+@Getter
+public enum ErrorCode {
+
+    // ── Generic ──────────────────────────────────────────────────────────
+    UNCATEGORIZED_EXCEPTION(HttpStatus.INTERNAL_SERVER_ERROR, "UNCATEGORIZED_EXCEPTION", "error.uncategorized"),
+    INVALID_KEY           (HttpStatus.BAD_REQUEST,            "INVALID_KEY",            "error.invalid-key"),
+    UNAUTHORIZED          (HttpStatus.UNAUTHORIZED,           "UNAUTHORIZED",           "error.unauthorized"),
+    FORBIDDEN             (HttpStatus.FORBIDDEN,              "FORBIDDEN",              "error.forbidden"),
+    RESOURCE_NOT_FOUND    (HttpStatus.NOT_FOUND,              "RESOURCE_NOT_FOUND",     "error.resource-not-found"),
+
+    // ── Voucher ───────────────────────────────────────────────────────────
+    VOUCHER_NOT_FOUND           (HttpStatus.NOT_FOUND,   "VOUCHER_NOT_FOUND",           "voucher.not-found"),
+    VOUCHER_ALREADY_EXISTS      (HttpStatus.CONFLICT,    "VOUCHER_ALREADY_EXISTS",      "voucher.already-exists"),
+    VOUCHER_EXPIRED             (HttpStatus.GONE,        "VOUCHER_EXPIRED",             "voucher.expired"),
+    VOUCHER_NOT_YET_ACTIVE      (HttpStatus.BAD_REQUEST, "VOUCHER_NOT_YET_ACTIVE",      "voucher.not-yet-active"),
+    VOUCHER_INACTIVE            (HttpStatus.BAD_REQUEST, "VOUCHER_INACTIVE",            "voucher.inactive"),
+    VOUCHER_USAGE_EXHAUSTED     (HttpStatus.CONFLICT,    "VOUCHER_USAGE_EXHAUSTED",     "voucher.usage-exhausted"),
+    VOUCHER_USED_BY_USER        (HttpStatus.CONFLICT,    "VOUCHER_USED_BY_USER",        "voucher.used-by-user"),
+    VOUCHER_MIN_AMOUNT_NOT_MET  (HttpStatus.BAD_REQUEST, "VOUCHER_MIN_AMOUNT_NOT_MET",  "voucher.min-amount-not-met"),
+    VOUCHER_MIN_DURATION_NOT_MET(HttpStatus.BAD_REQUEST, "VOUCHER_MIN_DURATION_NOT_MET","voucher.min-duration-not-met"),
+    VOUCHER_MUST_BOOK_IN_ADVANCE(HttpStatus.BAD_REQUEST, "VOUCHER_MUST_BOOK_IN_ADVANCE","voucher.must-book-in-advance"),
+    VOUCHER_SCOPE_MISMATCH      (HttpStatus.BAD_REQUEST, "VOUCHER_SCOPE_MISMATCH",      "voucher.scope-mismatch"),
+    VOUCHER_FORBIDDEN_HOST      (HttpStatus.FORBIDDEN,   "VOUCHER_FORBIDDEN_HOST",      "voucher.forbidden-host"),
+    VOUCHER_CANNOT_DEACTIVATE   (HttpStatus.CONFLICT,    "VOUCHER_CANNOT_DEACTIVATE",   "voucher.cannot-deactivate-used");
+
+    ErrorCode(HttpStatus httpStatus, String code, String messageKey) {
+        this.httpStatus = httpStatus;
+        this.code = code;
+        this.messageKey = messageKey;
+    }
+
+    private final HttpStatus httpStatus;
+    private final String code;
+    private final String messageKey;
+}
