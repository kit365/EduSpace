+package com.eduspace.bookingservice.exception;
+
+import lombok.Getter;
+import org.springframework.http.HttpStatus;
+
+@Getter
+public enum SuccessCode {
+    VOUCHER_CREATED   (HttpStatus.CREATED, "VOUCHER_CREATED",    "voucher.create.success"),
+    VOUCHER_FETCHED   (HttpStatus.OK,      "VOUCHER_FETCHED",    "voucher.get.success"),
+    VOUCHER_LIST      (HttpStatus.OK,      "VOUCHER_LIST",       "voucher.list.success"),
+    VOUCHER_UPDATED   (HttpStatus.OK,      "VOUCHER_UPDATED",    "voucher.update.success"),
+    VOUCHER_DEACTIVATED(HttpStatus.OK,     "VOUCHER_DEACTIVATED","voucher.deactivate.success"),
+    VOUCHER_VALID     (HttpStatus.OK,      "VOUCHER_VALID",      "voucher.validate.success"),
+    VOUCHER_APPLIED   (HttpStatus.OK,      "VOUCHER_APPLIED",    "voucher.apply.success"),
+    VOUCHER_RELEASED  (HttpStatus.OK,      "VOUCHER_RELEASED",   "voucher.release.success");
+
+    private final HttpStatus httpStatus;
+    private final String code;
+    private final String messageKey;
+
+    SuccessCode(HttpStatus httpStatus, String code, String messageKey) {
+        this.httpStatus = httpStatus;
+        this.code = code;
+        this.messageKey = messageKey;
+    }
+}
