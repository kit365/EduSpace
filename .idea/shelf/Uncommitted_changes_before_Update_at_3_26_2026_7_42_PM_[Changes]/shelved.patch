+package com.eduspace.bookingservice.presentation.controller;
+
+import com.eduspace.bookingservice.business.service.VoucherService;
+import com.eduspace.bookingservice.exception.SuccessCode;
+import com.eduspace.bookingservice.model.dto.request.ApplyVoucherRequest;
+import com.eduspace.bookingservice.model.dto.request.CreateVoucherRequest;
+import com.eduspace.bookingservice.model.dto.request.UpdateVoucherRequest;
+import com.eduspace.bookingservice.model.dto.response.ApiResponse;
+import com.eduspace.bookingservice.model.dto.response.PageResponse;
+import com.eduspace.bookingservice.model.dto.response.VoucherResponse;
+import com.eduspace.bookingservice.model.dto.response.VoucherUsageResponse;
+import com.eduspace.bookingservice.model.dto.response.VoucherValidateResponse;
+import com.eduspace.bookingservice.presentation.constants.VoucherPaths;
+
+import jakarta.validation.Valid;
+import lombok.RequiredArgsConstructor;
+import org.springframework.context.MessageSource;
+import org.springframework.context.i18n.LocaleContextHolder;
+import org.springframework.data.domain.PageRequest;
+import org.springframework.data.domain.Pageable;
+import org.springframework.security.access.prepost.PreAuthorize;
+import org.springframework.security.core.annotation.AuthenticationPrincipal;
+import org.springframework.security.oauth2.jwt.Jwt;
+import org.springframework.web.bind.annotation.*;
+
+import java.util.Collection;
+
+@RestController
+@RequestMapping(VoucherPaths.BASE)
+@RequiredArgsConstructor
+public class VoucherController {
+
+    private final VoucherService voucherService;
+    private final MessageSource messageSource;
+
+    @PostMapping
+    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN', 'HOST')")
+    public ApiResponse<VoucherResponse> createVoucher(@Valid @RequestBody CreateVoucherRequest request,
+                                                      @AuthenticationPrincipal Jwt jwt) {
+        String userId = jwt.getSubject();
+        boolean isAdmin = hasRole(jwt, "ROLE_ADMIN") || hasRole(jwt, "ROLE_SUPER_ADMIN");
+        
+        VoucherResponse response = voucherService.createVoucher(request, userId, isAdmin);
+        String msg = messageSource.getMessage(SuccessCode.VOUCHER_CREATED.getMessageKey(), null, LocaleContextHolder.getLocale());
+        return ApiResponse.success(response, SuccessCode.VOUCHER_CREATED, msg);
+    }
+
+    @PutMapping(VoucherPaths.ID)
+    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN', 'HOST')")
+    public ApiResponse<VoucherResponse> updateVoucher(@PathVariable Long id,
+                                                      @Valid @RequestBody UpdateVoucherRequest request,
+                                                      @AuthenticationPrincipal Jwt jwt) {
+        String userId = jwt.getSubject();
+        boolean isAdmin = hasRole(jwt, "ROLE_ADMIN") || hasRole(jwt, "ROLE_SUPER_ADMIN");
+        
+        VoucherResponse response = voucherService.updateVoucher(id, request, userId, isAdmin);
+        String msg = messageSource.getMessage(SuccessCode.VOUCHER_UPDATED.getMessageKey(), null, LocaleContextHolder.getLocale());
+        return ApiResponse.success(response, SuccessCode.VOUCHER_UPDATED, msg);
+    }
+
+    @DeleteMapping(VoucherPaths.ID)
+    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN', 'HOST')")
+    public ApiResponse<Void> deactivateVoucher(@PathVariable Long id,
+                                               @AuthenticationPrincipal Jwt jwt) {
+        String userId = jwt.getSubject();
+        boolean isAdmin = hasRole(jwt, "ROLE_ADMIN") || hasRole(jwt, "ROLE_SUPER_ADMIN");
+        
+        voucherService.deactivateVoucher(id, userId, isAdmin);
+        String msg = messageSource.getMessage(SuccessCode.VOUCHER_DEACTIVATED.getMessageKey(), null, LocaleContextHolder.getLocale());
+        return ApiResponse.success(null, SuccessCode.VOUCHER_DEACTIVATED, msg);
+    }
+
+    @PostMapping(VoucherPaths.VALIDATE)
+    public ApiResponse<VoucherValidateResponse> validateVoucher(@Valid @RequestBody ApplyVoucherRequest request,
+                                                                @AuthenticationPrincipal Jwt jwt) {
+        String userId = jwt != null ? jwt.getSubject() : "anonymous";
+        VoucherValidateResponse response = voucherService.validateVoucher(request, userId);
+        String msg = messageSource.getMessage(SuccessCode.VOUCHER_VALID.getMessageKey(), null, LocaleContextHolder.getLocale());
+        return ApiResponse.success(response, SuccessCode.VOUCHER_VALID, msg);
+    }
+
+    @PostMapping(VoucherPaths.APPLY)
+    public ApiResponse<VoucherUsageResponse> applyVoucher(@Valid @RequestBody ApplyVoucherRequest request,
+                                                          @AuthenticationPrincipal Jwt jwt) {
+        String userId = jwt.getSubject();
+        VoucherUsageResponse response = voucherService.applyVoucher(request, userId);
+        // The service internally ensures this is a synchronized database call preventing race-conditions
+        String msg = messageSource.getMessage(SuccessCode.VOUCHER_APPLIED.getMessageKey(), null, LocaleContextHolder.getLocale());
+        return ApiResponse.success(response, SuccessCode.VOUCHER_APPLIED, msg);
+    }
+
+    @PostMapping(VoucherPaths.CANCEL_USAGE)
+    public ApiResponse<Void> releaseVoucherUsage(@RequestParam String bookingId,
+                                                 @AuthenticationPrincipal Jwt jwt) {
+        String userId = jwt.getSubject();
+        voucherService.releaseVoucherUsage(bookingId, userId);
+        String msg = messageSource.getMessage(SuccessCode.VOUCHER_RELEASED.getMessageKey(), null, LocaleContextHolder.getLocale());
+        return ApiResponse.success(null, SuccessCode.VOUCHER_RELEASED, msg);
+    }
+
+    @GetMapping(VoucherPaths.ID)
+    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN', 'HOST')")
+    public ApiResponse<VoucherResponse> getVoucherById(@PathVariable Long id,
+                                                       @AuthenticationPrincipal Jwt jwt) {
+        String userId = jwt.getSubject();
+        boolean isAdmin = hasRole(jwt, "ROLE_ADMIN") || hasRole(jwt, "ROLE_SUPER_ADMIN");
+        
+        VoucherResponse response = voucherService.getVoucherById(id, userId, isAdmin);
+        String msg = messageSource.getMessage(SuccessCode.VOUCHER_FETCHED.getMessageKey(), null, LocaleContextHolder.getLocale());
+        return ApiResponse.success(response, SuccessCode.VOUCHER_FETCHED, msg);
+    }
+
+    @GetMapping
+    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN', 'HOST')")
+    public ApiResponse<PageResponse<VoucherResponse>> getSystemVouchers(@RequestParam(defaultValue = "0") int page,
+                                                                        @RequestParam(defaultValue = "10") int size,
+                                                                        @RequestParam(required = false) String codeSearch,
+                                                                        @AuthenticationPrincipal Jwt jwt) {
+        String userId = jwt.getSubject();
+        boolean isAdmin = hasRole(jwt, "ROLE_ADMIN") || hasRole(jwt, "ROLE_SUPER_ADMIN");
+        Pageable pageable = PageRequest.of(page, size);
+        
+        PageResponse<VoucherResponse> response = voucherService.getVouchers(pageable, codeSearch, userId, isAdmin);
+        String msg = messageSource.getMessage(SuccessCode.VOUCHER_LIST.getMessageKey(), null, LocaleContextHolder.getLocale());
+        return ApiResponse.success(response, SuccessCode.VOUCHER_LIST, msg);
+    }
+
+    @GetMapping(VoucherPaths.PUBLIC)
+    public ApiResponse<PageResponse<VoucherResponse>> getPublicActiveVouchers(@RequestParam(defaultValue = "0") int page,
+                                                                              @RequestParam(defaultValue = "10") int size) {
+        Pageable pageable = PageRequest.of(page, size);
+        PageResponse<VoucherResponse> response = voucherService.getPublicActiveVouchers(pageable);
+        String msg = messageSource.getMessage(SuccessCode.VOUCHER_LIST.getMessageKey(), null, LocaleContextHolder.getLocale());
+        return ApiResponse.success(response, SuccessCode.VOUCHER_LIST, msg);
+    }
+
+    @GetMapping(VoucherPaths.USAGES)
+    @PreAuthorize("hasAnyRole('ADMIN', 'SUPER_ADMIN', 'HOST')")
+    public ApiResponse<PageResponse<VoucherUsageResponse>> getVoucherUsages(@PathVariable Long id,
+                                                                            @RequestParam(defaultValue = "0") int page,
+                                                                            @RequestParam(defaultValue = "10") int size,
+                                                                            @AuthenticationPrincipal Jwt jwt) {
+        String userId = jwt.getSubject();
+        boolean isAdmin = hasRole(jwt, "ROLE_ADMIN") || hasRole(jwt, "ROLE_SUPER_ADMIN");
+        Pageable pageable = PageRequest.of(page, size);
+        
+        PageResponse<VoucherUsageResponse> response = voucherService.getVoucherUsages(id, pageable, userId, isAdmin);
+        String msg = messageSource.getMessage(SuccessCode.VOUCHER_LIST.getMessageKey(), null, LocaleContextHolder.getLocale());
+        return ApiResponse.success(response, SuccessCode.VOUCHER_LIST, msg);
+    }
+
+    private boolean hasRole(Jwt jwt, String role) {
+        Collection<String> roles = jwt.getClaimAsStringList("roles");
+        return roles != null && roles.contains(role);
+    }
+}
