+package com.eduspace.bookingservice.business.serviceimpl;
+
+import com.eduspace.bookingservice.business.service.VoucherService;
+import com.eduspace.bookingservice.common.enums.DiscountType;
+import com.eduspace.bookingservice.common.enums.IssuerType;
+import com.eduspace.bookingservice.common.enums.VoucherScope;
+import com.eduspace.bookingservice.exception.AppException;
+import com.eduspace.bookingservice.exception.ErrorCode;
+import com.eduspace.bookingservice.model.dto.request.ApplyVoucherRequest;
+import com.eduspace.bookingservice.model.dto.request.CreateVoucherRequest;
+import com.eduspace.bookingservice.model.dto.request.UpdateVoucherRequest;
+import com.eduspace.bookingservice.model.dto.response.PageResponse;
+import com.eduspace.bookingservice.model.dto.response.VoucherResponse;
+import com.eduspace.bookingservice.model.dto.response.VoucherUsageResponse;
+import com.eduspace.bookingservice.model.dto.response.VoucherValidateResponse;
+import com.eduspace.bookingservice.model.entity.VoucherEntity;
+import com.eduspace.bookingservice.model.entity.VoucherUsageEntity;
+import com.eduspace.bookingservice.model.mapper.VoucherMapper;
+import com.eduspace.bookingservice.persistence.repository.VoucherRepository;
+import com.eduspace.bookingservice.persistence.repository.VoucherUsageRepository;
+
+import lombok.RequiredArgsConstructor;
+import lombok.extern.slf4j.Slf4j;
+import org.springframework.data.domain.Page;
+import org.springframework.data.domain.Pageable;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+import org.springframework.util.StringUtils;
+
+import java.math.BigDecimal;
+import java.math.RoundingMode;
+import java.time.LocalDateTime;
+import java.time.temporal.ChronoUnit;
+import java.util.List;
+import java.util.Optional;
+import java.util.stream.Collectors;
+
+@Slf4j
+@Service
+@RequiredArgsConstructor
+public class VoucherServiceImpl implements VoucherService {
+
+    private final VoucherRepository voucherRepository;
+    private final VoucherUsageRepository voucherUsageRepository;
+    private final VoucherMapper voucherMapper;
+
+    @Override
+    @Transactional
+    public VoucherResponse createVoucher(CreateVoucherRequest request, String issuerId, boolean isAdmin) {
+        log.info("Creating voucher {} by user {} (isAdmin: {})", request.getCode(), issuerId, isAdmin);
+
+        if (voucherRepository.findByCode(request.getCode().toUpperCase()).isPresent()) {
+            throw new AppException(ErrorCode.VOUCHER_ALREADY_EXISTS);
+        }
+
+        // Host security check
+        if (!isAdmin) {
+            if (request.getScope() == VoucherScope.GLOBAL || request.getScope() == VoucherScope.CATEGORY) {
+                throw new AppException(ErrorCode.VOUCHER_FORBIDDEN_HOST);
+            }
+            // Real projection would verify ownership with room-service here
+        }
+
+        VoucherEntity entity = voucherMapper.toEntity(request);
+        entity.setIsActive(true);
+        entity.setUsedCount(0);
+        entity.setIssuerType(isAdmin ? IssuerType.SYSTEM : IssuerType.HOST);
+        entity.setCreatedByUserId(issuerId);
+
+        return voucherMapper.toResponse(voucherRepository.save(entity));
+    }
+
+    @Override
+    @Transactional
+    public VoucherResponse updateVoucher(Long id, UpdateVoucherRequest request, String requesterId, boolean isAdmin) {
+        VoucherEntity voucher = getVoucherSecured(id, requesterId, isAdmin);
+
+        if (request.getName() != null) voucher.setName(request.getName());
+        if (request.getDescription() != null) voucher.setDescription(request.getDescription());
+        
+        if (request.getDiscountValue() != null) voucher.setDiscountValue(request.getDiscountValue());
+        if (request.getMaxDiscountAmount() != null) voucher.setMaxDiscountAmount(request.getMaxDiscountAmount());
+        
+        if (request.getMinBookingAmount() != null) voucher.setMinBookingAmount(request.getMinBookingAmount());
+        if (request.getMinBookingDurationHours() != null) voucher.setMinBookingDurationHours(request.getMinBookingDurationHours());
+        if (request.getMinHoursBeforeBooking() != null) voucher.setMinHoursBeforeBooking(request.getMinHoursBeforeBooking());
+        
+        if (request.getMaxUsageCount() != null) voucher.setMaxUsageCount(request.getMaxUsageCount());
+        if (request.getMaxUsagePerUser() != null) voucher.setMaxUsagePerUser(request.getMaxUsagePerUser());
+        
+        if (request.getValidFrom() != null) voucher.setValidFrom(request.getValidFrom());
+        if (request.getValidUntil() != null) voucher.setValidUntil(request.getValidUntil());
+
+        return voucherMapper.toResponse(voucherRepository.save(voucher));
+    }
+
+    @Override
+    @Transactional
+    public void deactivateVoucher(Long id, String requesterId, boolean isAdmin) {
+        VoucherEntity voucher = getVoucherSecured(id, requesterId, isAdmin);
+
+        if (voucher.getUsedCount() > 0) {
+            throw new AppException(ErrorCode.VOUCHER_CANNOT_DEACTIVATE);
+        }
+
+        voucher.setIsActive(false);
+        voucherRepository.save(voucher);
+    }
+
+    @Override
+    @Transactional(readOnly = true)
+    public VoucherValidateResponse validateVoucher(ApplyVoucherRequest request, String userId) {
+        VoucherEntity voucher = voucherRepository.findByCodeAndIsActive(request.getCode().toUpperCase(), true)
+                .orElseThrow(() -> new AppException(ErrorCode.VOUCHER_NOT_FOUND));
+
+        validateConditions(voucher, request, userId, false);
+
+        BigDecimal discountAmount = calculateDiscount(voucher, request);
+        return VoucherValidateResponse.builder()
+                .voucherId(voucher.getId())
+                .code(voucher.getCode())
+                .name(voucher.getName())
+                .discountType(voucher.getDiscountType())
+                .discountValue(voucher.getDiscountValue())
+                .discountAmount(discountAmount)
+                .originalAmount(request.getTotalAmount())
+                .finalAmount(request.getTotalAmount().subtract(discountAmount))
+                .message("Áp dụng thành công!")
+                .build();
+    }
+
+    @Override
+    @Transactional
+    public VoucherUsageResponse applyVoucher(ApplyVoucherRequest request, String userId) {
+        if (request.getBookingId() == null) {
+            throw new AppException(ErrorCode.INVALID_KEY);
+        }
+
+        VoucherEntity voucher = voucherRepository.findByCodeAndIsActive(request.getCode().toUpperCase(), true)
+                .orElseThrow(() -> new AppException(ErrorCode.VOUCHER_NOT_FOUND));
+
+        validateConditions(voucher, request, userId, true);
+
+        // Deduct DB count
+        int updatedRows = voucherRepository.incrementUsedCountAtomically(voucher.getId());
+        if (updatedRows == 0) {
+            throw new AppException(ErrorCode.VOUCHER_USAGE_EXHAUSTED);
+        }
+
+        BigDecimal discountAmount = calculateDiscount(voucher, request);
+
+        VoucherUsageEntity usage = VoucherUsageEntity.builder()
+                .voucherId(voucher.getId())
+                .userId(userId)
+                .bookingId(request.getBookingId())
+                .discountAmount(discountAmount)
+                .build();
+
+        voucherUsageRepository.save(usage);
+        return voucherMapper.toResponse(usage, voucher.getCode());
+    }
+
+    @Override
+    @Transactional
+    public void releaseVoucherUsage(String bookingId, String userId) {
+        voucherUsageRepository.findByBookingId(bookingId).ifPresent(usage -> {
+            if (usage.getUserId().equals(userId)) {
+                voucherUsageRepository.delete(usage);
+                voucherRepository.decrementUsedCountAtomically(usage.getVoucherId());
+                log.info("Released voucher usage for booking {} user {}", bookingId, userId);
+            }
+        });
+    }
+
+    @Override
+    @Transactional(readOnly = true)
+    public VoucherResponse getVoucherById(Long id, String requesterId, boolean isAdmin) {
+        return voucherMapper.toResponse(getVoucherSecured(id, requesterId, isAdmin));
+    }
+
+    @Override
+    @Transactional(readOnly = true)
+    public PageResponse<VoucherResponse> getVouchers(Pageable pageable, String codeSearch, String issuerId, boolean isAdmin) {
+        Page<VoucherEntity> pageResult;
+        
+        if (isAdmin) {
+            pageResult = voucherRepository.findAll(pageable); // Can be enhanced with QueryDSL for search
+        } else {
+            pageResult = voucherRepository.findAllByCreatedByUserId(issuerId, pageable);
+        }
+
+        List<VoucherResponse> content = pageResult.getContent().stream()
+                .map(voucherMapper::toResponse)
+                .collect(Collectors.toList());
+
+        return PageResponse.of(pageResult, content);
+    }
+
+    @Override
+    @Transactional(readOnly = true)
+    public PageResponse<VoucherResponse> getPublicActiveVouchers(Pageable pageable) {
+        Page<VoucherEntity> pageResult = voucherRepository.findPublicActiveVouchers(LocalDateTime.now(), pageable);
+        List<VoucherResponse> content = pageResult.getContent().stream()
+                .map(voucherMapper::toResponse)
+                .collect(Collectors.toList());
+        return PageResponse.of(pageResult, content);
+    }
+
+    @Override
+    @Transactional(readOnly = true)
+    public PageResponse<VoucherUsageResponse> getVoucherUsages(Long voucherId, Pageable pageable, String requesterId, boolean isAdmin) {
+        VoucherEntity voucher = getVoucherSecured(voucherId, requesterId, isAdmin);
+        
+        Page<VoucherUsageEntity> pageResult = voucherUsageRepository.findByVoucherId(voucherId, pageable);
+        List<VoucherUsageResponse> content = pageResult.getContent().stream()
+                .map(usage -> voucherMapper.toResponse(usage, voucher.getCode()))
+                .collect(Collectors.toList());
+                
+        return PageResponse.of(pageResult, content);
+    }
+
+    // ── Private Helpers ────────────────────────────────────────────────────────
+
+    private VoucherEntity getVoucherSecured(Long id, String requesterId, boolean isAdmin) {
+        VoucherEntity voucher = voucherRepository.findById(id)
+                .orElseThrow(() -> new AppException(ErrorCode.VOUCHER_NOT_FOUND));
+
+        if (!isAdmin && !voucher.getCreatedByUserId().equals(requesterId)) {
+            throw new AppException(ErrorCode.FORBIDDEN);
+        }
+        return voucher;
+    }
+
+    private void validateConditions(VoucherEntity voucher, ApplyVoucherRequest req, String userId, boolean isApplying) {
+        LocalDateTime now = LocalDateTime.now();
+
+        // 1. Valid Active Dates
+        if (now.isBefore(voucher.getValidFrom())) throw new AppException(ErrorCode.VOUCHER_NOT_YET_ACTIVE);
+        if (now.isAfter(voucher.getValidUntil())) throw new AppException(ErrorCode.VOUCHER_EXPIRED);
+
+        // 2. Global Max Usage
+        if (voucher.getMaxUsageCount() != null && voucher.getUsedCount() >= voucher.getMaxUsageCount()) {
+            throw new AppException(ErrorCode.VOUCHER_USAGE_EXHAUSTED);
+        }
+
+        // 3. User Max Usage
+        long userUsageCount = voucherUsageRepository.countByVoucherIdAndUserId(voucher.getId(), userId);
+        if (userUsageCount >= voucher.getMaxUsagePerUser()) {
+            throw new AppException(ErrorCode.VOUCHER_USED_BY_USER);
+        }
+
+        // 4. Double booking apply check
+        if (isApplying && req.getBookingId() != null) {
+            if (voucherUsageRepository.findByBookingId(req.getBookingId()).isPresent()) {
+                throw new AppException(ErrorCode.INVALID_KEY); // Already applied a voucher
+            }
+        }
+
+        // 5. Min Booking constraints
+        if (voucher.getMinBookingAmount() != null && req.getTotalAmount().compareTo(voucher.getMinBookingAmount()) < 0) {
+            throw new AppException(ErrorCode.VOUCHER_MIN_AMOUNT_NOT_MET);
+        }
+        if (voucher.getMinBookingDurationHours() != null && req.getDurationHours() < voucher.getMinBookingDurationHours()) {
+            throw new AppException(ErrorCode.VOUCHER_MIN_DURATION_NOT_MET);
+        }
+
+        // 6. Early bird booking constraints
+        if (voucher.getMinHoursBeforeBooking() != null) {
+            long hoursUntilBooking = ChronoUnit.HOURS.between(now, req.getBookingStartTime());
+            if (hoursUntilBooking < voucher.getMinHoursBeforeBooking()) {
+                throw new AppException(ErrorCode.VOUCHER_MUST_BOOK_IN_ADVANCE);
+            }
+        }
+
+        // 7. Check Scope
+        validateScope(voucher, req);
+    }
+
+    private void validateScope(VoucherEntity voucher, ApplyVoucherRequest req) {
+        switch (voucher.getScope()) {
+            case GLOBAL -> { /* Valid for all */ }
+            case ROOM -> {
+                if (!req.getRoomId().equals(voucher.getScopeRoomId())) 
+                    throw new AppException(ErrorCode.VOUCHER_SCOPE_MISMATCH);
+            }
+            case PROPERTY -> {
+                if (req.getPropertyId() == null || !req.getPropertyId().equals(voucher.getScopePropertyId()))
+                    throw new AppException(ErrorCode.VOUCHER_SCOPE_MISMATCH);
+            }
+            case CATEGORY -> {
+                if (req.getRoomCategory() == null || !req.getRoomCategory().equalsIgnoreCase(voucher.getScopeRoomCategory()))
+                    throw new AppException(ErrorCode.VOUCHER_SCOPE_MISMATCH);
+            }
+        }
+    }
+
+    private BigDecimal calculateDiscount(VoucherEntity voucher, ApplyVoucherRequest req) {
+        return switch (voucher.getDiscountType()) {
+            case PERCENTAGE -> {
+                BigDecimal percent = voucher.getDiscountValue().divide(BigDecimal.valueOf(100), 4, RoundingMode.HALF_UP);
+                BigDecimal raw = req.getTotalAmount().multiply(percent);
+                if (voucher.getMaxDiscountAmount() != null) {
+                    raw = raw.min(voucher.getMaxDiscountAmount());
+                }
+                yield raw.setScale(2, RoundingMode.HALF_UP);
+            }
+            case FIXED_AMOUNT -> voucher.getDiscountValue().min(req.getTotalAmount());
+            case FREE_HOURS -> {
+                BigDecimal freeHours = voucher.getDiscountValue();
+                if (freeHours.intValue() >= req.getDurationHours()) {
+                    yield req.getTotalAmount();
+                }
+                BigDecimal pricePerHour = req.getTotalAmount()
+                        .divide(BigDecimal.valueOf(req.getDurationHours()), 2, RoundingMode.HALF_UP);
+                yield freeHours.multiply(pricePerHour).min(req.getTotalAmount()).setScale(2, RoundingMode.HALF_UP);
+            }
+        };
+    }
+}
