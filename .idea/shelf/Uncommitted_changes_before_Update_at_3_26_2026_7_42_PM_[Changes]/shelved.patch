+package com.eduspace.bookingservice.model.dto.request;
+
+import com.eduspace.bookingservice.common.enums.DiscountType;
+import com.eduspace.bookingservice.common.enums.IssuerType;
+import com.eduspace.bookingservice.common.enums.VoucherScope;
+import jakarta.validation.constraints.*;
+import lombok.Data;
+
+import java.math.BigDecimal;
+import java.time.LocalDateTime;
+
+@Data
+public class CreateVoucherRequest {
+
+    @NotBlank(message = "error.invalid-key")
+    @Size(min = 3, max = 50, message = "error.invalid-key")
+    @Pattern(regexp = "^[A-Z0-9_\\-]+$", message = "error.invalid-key")
+    private String code;
+
+    @NotBlank(message = "error.invalid-key")
+    @Size(max = 255, message = "error.invalid-key")
+    private String name;
+
+    private String description;
+
+    // ── Discount ──────────────────────────────────────────────────────
+    @NotNull(message = "error.invalid-key")
+    private DiscountType discountType;
+
+    @NotNull(message = "error.invalid-key")
+    @DecimalMin(value = "0.01", message = "error.invalid-key")
+    private BigDecimal discountValue;
+
+    /** Maximum discount cap for PERCENTAGE type. Nullable. */
+    @DecimalMin(value = "0.01", message = "error.invalid-key")
+    private BigDecimal maxDiscountAmount;
+
+    // ── Scope ─────────────────────────────────────────────────────────
+    @NotNull(message = "error.invalid-key")
+    private VoucherScope scope;
+
+    /** Required if scope = ROOM */
+    private Long scopeRoomId;
+
+    /** Required if scope = PROPERTY */
+    private Long scopePropertyId;
+
+    /** Required if scope = CATEGORY */
+    private String scopeRoomCategory;
+
+    // ── Conditions ────────────────────────────────────────────────────
+    @DecimalMin(value = "0", message = "error.invalid-key")
+    private BigDecimal minBookingAmount;
+
+    @Min(value = 1, message = "error.invalid-key")
+    private Integer minBookingDurationHours;
+
+    @Min(value = 0, message = "error.invalid-key")
+    private Integer minHoursBeforeBooking;
+
+    // ── Usage limits ──────────────────────────────────────────────────
+    @Min(value = 1, message = "error.invalid-key")
+    private Integer maxUsageCount;
+
+    @NotNull(message = "error.invalid-key")
+    @Min(value = 1, message = "error.invalid-key")
+    private Integer maxUsagePerUser = 1;
+
+    // ── Validity ──────────────────────────────────────────────────────
+    @NotNull(message = "error.invalid-key")
+    private LocalDateTime validFrom;
+
+    @NotNull(message = "error.invalid-key")
+    private LocalDateTime validUntil;
+
+    // issuerType is resolved by server based on requester's role (not provided by client)
+}
