+package com.eduspace.bookingservice.model.dto.request;
+
+import jakarta.validation.constraints.*;
+import lombok.Data;
+
+import java.math.BigDecimal;
+import java.time.LocalDateTime;
+
+/**
+ * Sent by the booking flow to validate/preview how much discount will apply.
+ * Also used when actually applying the voucher to a confirmed booking.
+ */
+@Data
+public class ApplyVoucherRequest {
+
+    @NotBlank(message = "error.invalid-key")
+    private String code;
+
+    /** ID of the room being booked — needed for scope validation */
+    @NotNull(message = "error.invalid-key")
+    private Long roomId;
+
+    /**
+     * Optional: property ID of the room (to validate PROPERTY scope).
+     * Can be resolved server-side via room-service if not provided.
+     */
+    private Long propertyId;
+
+    /**
+     * Optional: category of the room (to validate CATEGORY scope).
+     */
+    private String roomCategory;
+
+    /** Total booking amount BEFORE discount (VND) */
+    @NotNull(message = "error.invalid-key")
+    @DecimalMin(value = "0.01", message = "error.invalid-key")
+    private BigDecimal totalAmount;
+
+    /** Duration of the booking in hours */
+    @NotNull(message = "error.invalid-key")
+    @Min(value = 1, message = "error.invalid-key")
+    private Integer durationHours;
+
+    /** Booking start time — used to check min_hours_before_booking */
+    @NotNull(message = "error.invalid-key")
+    private LocalDateTime bookingStartTime;
+
+    /**
+     * bookingId is only provided when APPLYING (not validating/preview).
+     * Leave null when calling the /validate endpoint.
+     */
+    private String bookingId;
+}
