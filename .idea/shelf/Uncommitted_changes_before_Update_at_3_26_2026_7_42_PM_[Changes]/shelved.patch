<+>\r\nservices:\r\n  # ═══════════════════════════════════════════════════════════════\r\n  # DATABASE PER SERVICE — Mỗi service 1 container PostgreSQL riêng\r\n  # ═══════════════════════════════════════════════════════════════\r\n\r\n  # DB của Account Service\r\n  account-db:\r\n    image: postgres:16-alpine\r\n    container_name: account-db\r\n    restart: always\r\n    environment:\r\n      POSTGRES_USER: ${POSTGRES_USER}\r\n      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}\r\n      POSTGRES_DB: eduspace_account\r\n    ports:\r\n      - \"${POSTGRES_ACCOUNT_HOST_PORT:-5432}:5432\"\r\n    volumes:\r\n      - account-pgdata:/var/lib/postgresql/data\r\n    networks:\r\n      - eduspace-network\r\n\r\n  # DB của Booking Service\r\n  booking-db:\r\n    image: postgres:16-alpine\r\n    container_name: booking-db\r\n    restart: always\r\n    environment:\r\n      POSTGRES_USER: ${POSTGRES_USER}\r\n      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}\r\n      POSTGRES_DB: eduspace_booking\r\n    ports:\r\n      - \"${POSTGRES_BOOKING_HOST_PORT:-5433}:5432\"\r\n    volumes:\r\n      - booking-pgdata:/var/lib/postgresql/data\r\n    networks:\r\n      - eduspace-network\r\n\r\n  # DB của Room Service (chuẩn bị sẵn)\r\n  room-db:\r\n    image: postgres:16-alpine\r\n    container_name: room-db\r\n    restart: always\r\n    environment:\r\n      POSTGRES_USER: ${POSTGRES_USER}\r\n      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}\r\n      POSTGRES_DB: eduspace_room\r\n    ports:\r\n      - \"${POSTGRES_ROOM_HOST_PORT:-5434}:5432\"\r\n    volumes:\r\n      - room-pgdata:/var/lib/postgresql/data\r\n    networks:\r\n      - eduspace-network\r\n\r\n  # DB của Conversation Service\r\n  conversation-db:\r\n    image: postgres:16-alpine\r\n    container_name: conversation-db\r\n    restart: always\r\n    environment:\r\n      POSTGRES_USER: ${POSTGRES_USER}\r\n      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}\r\n      POSTGRES_DB: eduspace_conversation\r\n    ports:\r\n      - \"${POSTGRES_CONVERSATION_HOST_PORT:-5435}:5432\"\r\n    volumes:\r\n      - conversation-pgdata:/var/lib/postgresql/data\r\n    networks:\r\n      - eduspace-network\r\n\r\n  # ═══════════════════════════════════════════════════════════════\r\n  # INFRASTRUCTURE\r\n  # ═══════════════════════════════════════════════════════════════\r\n\r\n  # Redis — Caching & email verification tokens\r\n  redis:\r\n    image: redis:7-alpine\r\n    container_name: eduspace-redis\r\n    restart: always\r\n    ports:\r\n      - \"${REDIS_PORT:-6379}:6379\"\r\n    volumes:\r\n      - redisdata:/data\r\n    networks:\r\n      - eduspace-network\r\n\r\n  # Kafka (Redpanda) — Saga/event bus\r\n  kafka:\r\n    image: redpandadata/redpanda:v24.3.6\r\n    container_name: eduspace-kafka\r\n    restart: always\r\n    command:\r\n      - redpanda\r\n      - start\r\n      - --overprovisioned\r\n      - --smp\r\n      - \"1\"\r\n      - --memory\r\n      - 1G\r\n      - --reserve-memory\r\n      - 0M\r\n      - --node-id\r\n      - \"0\"\r\n      - --check=false\r\n      - --kafka-addr\r\n      - internal://0.0.0.0:9092,external://0.0.0.0:19092\r\n      - --advertise-kafka-addr\r\n      - internal://kafka:9092,external://localhost:19092\r\n    ports:\r\n      - \"9092:9092\"\r\n      - \"19092:19092\"\r\n    networks:\r\n      - eduspace-network\r\n\r\n  # Keycloak Database (tách riêng)\r\n  keycloak-db:\r\n    image: postgres:16-alpine\r\n    container_name: keycloak-postgres\r\n    restart: always\r\n    environment:\r\n      POSTGRES_DB: keycloak\r\n      POSTGRES_USER: keycloak\r\n      POSTGRES_PASSWORD: ${KEYCLOAK_DB_PASSWORD:-keycloak_dev_123}\r\n    volumes:\r\n      - keycloakdata:/var/lib/postgresql/data\r\n    networks:\r\n      - eduspace-network\r\n\r\n  # Keycloak Identity Server\r\n  keycloak:\r\n    image: quay.io/keycloak/keycloak:26.1\r\n    container_name: keycloak\r\n    command: start-dev --import-realm\r\n    environment:\r\n      KC_DB: postgres\r\n      KC_DB_URL: jdbc:postgresql://keycloak-db:5432/keycloak\r\n      KC_DB_USERNAME: keycloak\r\n      KC_DB_PASSWORD: ${KEYCLOAK_DB_PASSWORD:-keycloak_dev_123}\r\n      KC_HOSTNAME_STRICT: \"false\"\r\n      KC_HTTP_ENABLED: \"true\"\r\n      KC_PROXY_HEADERS: xforwarded\r\n      KEYCLOAK_ADMIN: ${KEYCLOAK_ADMIN_USER}\r\n      KEYCLOAK_ADMIN_PASSWORD: ${KEYCLOAK_ADMIN_PASSWORD}\r\n    ports:\r\n      - \"${KEYCLOAK_PORT}:8080\"\r\n    volumes:\r\n      - ./realm-export.json:/opt/keycloak/data/import/realm.json\r\n    depends_on:\r\n      - keycloak-db\r\n    networks:\r\n      - eduspace-network\r\n\r\n  # Eureka Discovery Server\r\n  discovery-server:\r\n    build:\r\n      context: ./discovery-server\r\n      dockerfile: Dockerfile\r\n    container_name: discovery-server\r\n    ports:\r\n      - \"${DISCOVERY_SERVER_PORT:-8761}:8761\"\r\n    networks:\r\n      - eduspace-network\r\n\r\n  # ═══════════════════════════════════════════════════════════════\r\n  # MICROSERVICES\r\n  # ═══════════════════════════════════════════════════════════════\r\n\r\n  # Account Service → account-db:5432/eduspace_account\r\n  account-service:\r\n    build:\r\n      context: ./account-service\r\n      dockerfile: Dockerfile\r\n    container_name: account-service\r\n    ports:\r\n      - \"${ACCOUNT_SERVICE_PORT}:8081\"\r\n    environment:\r\n      SPRING_DATASOURCE_URL: jdbc:postgresql://account-db:5432/eduspace_account\r\n      SPRING_DATASOURCE_USERNAME: ${POSTGRES_USER}\r\n      SPRING_DATASOURCE_PASSWORD: ${POSTGRES_PASSWORD}\r\n      SPRING_DATA_REDIS_HOST: redis\r\n      SPRING_DATA_REDIS_PORT: 6379\r\n      KEYCLOAK_SERVER_URL: http://keycloak:8080\r\n      KEYCLOAK_CLIENT_ID: eduspace-be\r\n      KEYCLOAK_CLIENT_SECRET: ${KEYCLOAK_CLIENT_SECRET}\r\n      KEYCLOAK_REALM: eduspace\r\n      KEYCLOAK_ISSUER_URI: http://keycloak:8080/realms/eduspace\r\n      KEYCLOAK_JWK_SET_URI: http://keycloak:8080/realms/eduspace/protocol/openid-connect/certs\r\n      EUREKA_SERVER_URL: http://discovery-server:8761/eureka/\r\n      SPRING_MAIL_HOST: ${SPRING_MAIL_HOST:-smtp.gmail.com}\r\n      SPRING_MAIL_PORT: ${SPRING_MAIL_PORT:-587}\r\n      SPRING_MAIL_USERNAME: ${SPRING_MAIL_USERNAME}\r\n      SPRING_MAIL_PASSWORD: ${SPRING_MAIL_PASSWORD}\r\n      SPRING_MAIL_FROM: ${SPRING_MAIL_FROM}\r\n      SPRING_MAIL_DISPLAY_NAME: ${SPRING_MAIL_DISPLAY_NAME:-EduSpace Support}\r\n      SPRING_MAIL_DEBUG: ${SPRING_MAIL_DEBUG:-false}\r\n    depends_on:\r\n      - account-db\r\n      - redis\r\n      - keycloak\r\n      - discovery-server\r\n    networks:\r\n      - eduspace-network\r\n\r\n  # Booking Service → booking-db:5432/eduspace_booking\r\n  booking-service:\r\n    build:\r\n      context: ./booking-service\r\n      dockerfile: Dockerfile\r\n    container_name: booking-service\r\n    ports:\r\n      - \"${BOOKING_SERVICE_PORT}:8082\"\r\n    environment:\r\n      SPRING_DATASOURCE_URL: jdbc:postgresql://booking-db:5432/eduspace_booking\r\n      SPRING_DATASOURCE_USERNAME: ${POSTGRES_USER}\r\n      SPRING_DATASOURCE_PASSWORD: ${POSTGRES_PASSWORD}\r\n      KEYCLOAK_ISSUER_URI: http://keycloak:8080/realms/eduspace\r\n      KEYCLOAK_JWK_SET_URI: http://keycloak:8080/realms/eduspace/protocol/openid-connect/certs\r\n      EUREKA_SERVER_URL: http://discovery-server:8761/eureka/\r\n    depends_on:\r\n      - booking-db\r\n      - keycloak\r\n      - discovery-server\r\n    networks:\r\n      - eduspace-network\r\n\r\n  # Conversation Service → conversation-db:5432/eduspace_conversation\r\n  conversation-service:\r\n    build:\r\n      context: ./conversation-service\r\n      dockerfile: Dockerfile\r\n    container_name: conversation-service\r\n    ports:\r\n      - \"${CONVERSATION_SERVICE_PORT:-8084}:8083\"\r\n    environment:\r\n      SERVER_PORT: 8083\r\n      SPRING_DATASOURCE_URL: jdbc:postgresql://conversation-db:5432/eduspace_conversation\r\n      SPRING_DATASOURCE_USERNAME: ${POSTGRES_USER}\r\n      SPRING_DATASOURCE_PASSWORD: ${POSTGRES_PASSWORD}\r\n      KEYCLOAK_ISSUER_URI: http://keycloak:8080/realms/eduspace\r\n      KEYCLOAK_JWK_SET_URI: http://keycloak:8080/realms/eduspace/protocol/openid-connect/certs\r\n      EUREKA_SERVER_URL: http://discovery-server:8761/eureka/\r\n      KAFKA_BOOTSTRAP_SERVERS: kafka:9092\r\n      MEDIA_PUBLIC_BASE_URL: http://localhost:${GATEWAY_PORT}\r\n    depends_on:\r\n      - conversation-db\r\n      - kafka\r\n      - keycloak\r\n      - discovery-server\r\n    networks:\r\n      - eduspace-network\r\n\r\n  # Room Service → room-db:5432/eduspace_room\r\n  room-service:\r\n    build:\r\n      context: ./room-service\r\n      dockerfile: Dockerfile\r\n    container_name: room-service\r\n    ports:\r\n      - \"${ROOM_SERVICE_PORT:-8083}:8083\"\r\n    environment:\r\n      SPRING_DATASOURCE_URL: jdbc:postgresql://room-db:5432/eduspace_room\r\n      SPRING_DATASOURCE_USERNAME: ${POSTGRES_USER}\r\n      SPRING_DATASOURCE_PASSWORD: ${POSTGRES_PASSWORD}\r\n      EUREKA_SERVER_URL: http://discovery-server:8761/eureka/\r\n    depends_on:\r\n      - room-db\r\n      - discovery-server\r\n    networks:\r\n      - eduspace-network\r\n\r\n  # API Gateway\r\n  api-gateway:\r\n    build:\r\n      context: ./api-gateway-service\r\n      dockerfile: Dockerfile\r\n    container_name: api-gateway\r\n    ports:\r\n      - \"${GATEWAY_PORT}:8080\"\r\n    environment:\r\n      EUREKA_SERVER_URL: http://discovery-server:8761/eureka/\r\n      KEYCLOAK_ISSUER_URI: http://keycloak:8080/realms/eduspace\r\n      KEYCLOAK_JWK_SET_URI: http://keycloak:8080/realms/eduspace/protocol/openid-connect/certs\r\n    depends_on:\r\n      - discovery-server\r\n      - keycloak\r\n    networks:\r\n      - eduspace-network\r\n\r\n# ═══════════════════════════════════════════════════════════════\r\n# NETWORKS & VOLUMES\r\n# ═══════════════════════════════════════════════════════════════\r\nnetworks:\r\n  eduspace-network:\r\n    driver: bridge\r\n\r\nvolumes:\r\n  account-pgdata:\r\n  booking-pgdata:\r\n  room-pgdata:\r\n  conversation-pgdata:\r\n  redisdata:\r\n  keycloakdata:\r\n
