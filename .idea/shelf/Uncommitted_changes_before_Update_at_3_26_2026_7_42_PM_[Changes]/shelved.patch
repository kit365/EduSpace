+package com.eduspace.bookingservice.model.mapper;
+
+import com.eduspace.bookingservice.model.dto.request.CreateVoucherRequest;
+import com.eduspace.bookingservice.model.dto.response.VoucherResponse;
+import com.eduspace.bookingservice.model.dto.response.VoucherUsageResponse;
+import com.eduspace.bookingservice.model.entity.VoucherEntity;
+import com.eduspace.bookingservice.model.entity.VoucherUsageEntity;
+import org.springframework.stereotype.Component;
+
+@Component
+public class VoucherMapper {
+
+    public VoucherEntity toEntity(CreateVoucherRequest request) {
+        if (request == null) {
+            return null;
+        }
+
+        return VoucherEntity.builder()
+                .code(request.getCode().toUpperCase())
+                .name(request.getName())
+                .description(request.getDescription())
+                .discountType(request.getDiscountType())
+                .discountValue(request.getDiscountValue())
+                .maxDiscountAmount(request.getMaxDiscountAmount())
+                .scope(request.getScope())
+                .scopeRoomId(request.getScopeRoomId())
+                .scopePropertyId(request.getScopePropertyId())
+                .scopeRoomCategory(request.getScopeRoomCategory())
+                .minBookingAmount(request.getMinBookingAmount())
+                .minBookingDurationHours(request.getMinBookingDurationHours())
+                .minHoursBeforeBooking(request.getMinHoursBeforeBooking())
+                .maxUsageCount(request.getMaxUsageCount())
+                .maxUsagePerUser(request.getMaxUsagePerUser() != null ? request.getMaxUsagePerUser() : 1)
+                .validFrom(request.getValidFrom())
+                .validUntil(request.getValidUntil())
+                .build();
+    }
+
+    public VoucherResponse toResponse(VoucherEntity entity) {
+        if (entity == null) {
+            return null;
+        }
+
+        return VoucherResponse.builder()
+                .id(entity.getId())
+                .code(entity.getCode())
+                .name(entity.getName())
+                .description(entity.getDescription())
+                .discountType(entity.getDiscountType())
+                .discountValue(entity.getDiscountValue())
+                .maxDiscountAmount(entity.getMaxDiscountAmount())
+                .scope(entity.getScope())
+                .scopeRoomId(entity.getScopeRoomId())
+                .scopePropertyId(entity.getScopePropertyId())
+                .scopeRoomCategory(entity.getScopeRoomCategory())
+                .issuerType(entity.getIssuerType())
+                .createdByUserId(entity.getCreatedByUserId())
+                .minBookingAmount(entity.getMinBookingAmount())
+                .minBookingDurationHours(entity.getMinBookingDurationHours())
+                .minHoursBeforeBooking(entity.getMinHoursBeforeBooking())
+                .maxUsageCount(entity.getMaxUsageCount())
+                .usedCount(entity.getUsedCount())
+                .maxUsagePerUser(entity.getMaxUsagePerUser())
+                .validFrom(entity.getValidFrom())
+                .validUntil(entity.getValidUntil())
+                .isActive(entity.getIsActive())
+                .createdAt(entity.getCreatedAt())
+                .updatedAt(entity.getUpdatedAt())
+                .build();
+    }
+
+    public VoucherUsageResponse toResponse(VoucherUsageEntity entity, String voucherCode) {
+        if (entity == null) {
+            return null;
+        }
+
+        return VoucherUsageResponse.builder()
+                .id(entity.getId())
+                .voucherId(entity.getVoucherId())
+                .voucherCode(voucherCode)
+                .userId(entity.getUserId())
+                .bookingId(entity.getBookingId())
+                .discountAmount(entity.getDiscountAmount())
+                .appliedAt(entity.getAppliedAt())
+                .build();
+    }
+}
