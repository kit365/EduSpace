+
+    /** Actual discount amount computed for this booking */
+    private BigDecimal discountAmount;
+
+    /** Original amount before discount */
+    private BigDecimal originalAmount;
+
+    /** Final amount after discount (= originalAmount - discountAmount) */
+    private BigDecimal finalAmount;
+
+    /** Human-readable summary message, e.g. "Bạn tiết kiệm được 100.000đ" */
+    private String message;
+}
