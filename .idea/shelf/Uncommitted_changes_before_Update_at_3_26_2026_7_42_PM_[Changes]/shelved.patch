@@ -0,0 +1,85 @@
+-- =================================================================
+-- V1__init_voucher_schema.sql
+-- EduSpace Booking Service — Voucher System
+-- =================================================================
+
+-- =================================================================
+-- vouchers: Master table for all discount codes
+-- =================================================================
+CREATE TABLE vouchers (
+    id                          BIGSERIAL       PRIMARY KEY,
+    code                        VARCHAR(50)     NOT NULL UNIQUE,
+    name                        VARCHAR(255)    NOT NULL,
+    description                 TEXT,
+
+    -- Type & value
+    discount_type               VARCHAR(20)     NOT NULL
+                                    CHECK (discount_type IN ('PERCENTAGE', 'FIXED_AMOUNT', 'FREE_HOURS')),
+    discount_value              NUMERIC(15,2)   NOT NULL,
+    max_discount_amount         NUMERIC(15,2),  -- Cap for PERCENTAGE type (e.g., max 200k)
+
+    -- Scope
+    scope                       VARCHAR(20)     NOT NULL DEFAULT 'GLOBAL'
+                                    CHECK (scope IN ('GLOBAL', 'ROOM', 'PROPERTY', 'CATEGORY')),
+    scope_room_id               BIGINT,         -- FK to rooms.id (when scope = ROOM)
+    scope_property_id           BIGINT,         -- FK to properties.id (when scope = PROPERTY)
+    scope_room_category         VARCHAR(100),   -- Room category (when scope = CATEGORY)
+
+    -- Issuer
+    issuer_type                 VARCHAR(20)     NOT NULL DEFAULT 'SYSTEM'
+                                    CHECK (issuer_type IN ('SYSTEM', 'HOST')),
+    created_by_user_id          VARCHAR(36)     NOT NULL,  -- keycloak user id
+
+    -- Booking conditions
+    min_booking_amount          NUMERIC(15,2),  -- Minimum booking value (VND)
+    min_booking_duration_hours  INTEGER,        -- Minimum booking duration (hours)
+    min_hours_before_booking    INTEGER,        -- Must book at least X hours in advance
+
+    -- Usage limits
+    max_usage_count             INTEGER,        -- NULL = unlimited
+    used_count                  INTEGER         NOT NULL DEFAULT 0,
+    max_usage_per_user          INTEGER         NOT NULL DEFAULT 1,
+
+    -- Validity period
+    valid_from                  TIMESTAMP       NOT NULL,
+    valid_until                 TIMESTAMP       NOT NULL,
+
+    -- State
+    is_active                   BOOLEAN         NOT NULL DEFAULT TRUE,
+
+    created_at                  TIMESTAMP       NOT NULL DEFAULT NOW(),
+    updated_at                  TIMESTAMP       NOT NULL DEFAULT NOW(),
+
+    CONSTRAINT chk_voucher_valid_period   CHECK (valid_until > valid_from),
+    CONSTRAINT chk_voucher_discount_pos   CHECK (discount_value > 0),
+    CONSTRAINT chk_voucher_usage_per_user CHECK (max_usage_per_user >= 1)
+);
+
+-- Indexes for common queries
+CREATE INDEX idx_vouchers_code            ON vouchers (code);
+CREATE INDEX idx_vouchers_active_valid    ON vouchers (is_active, valid_from, valid_until);
+CREATE INDEX idx_vouchers_issuer          ON vouchers (created_by_user_id);
+CREATE INDEX idx_vouchers_scope_room      ON vouchers (scope_room_id)     WHERE scope_room_id IS NOT NULL;
+CREATE INDEX idx_vouchers_scope_property  ON vouchers (scope_property_id) WHERE scope_property_id IS NOT NULL;
+
+
+-- =================================================================
+-- voucher_usages: Records every time a voucher is applied to a booking
+-- =================================================================
+CREATE TABLE voucher_usages (
+    id              BIGSERIAL       PRIMARY KEY,
+    voucher_id      BIGINT          NOT NULL REFERENCES vouchers(id) ON DELETE RESTRICT,
+    user_id         VARCHAR(36)     NOT NULL,       -- keycloak user id
+    booking_id      VARCHAR(36)     NOT NULL,       -- ID from booking table
+    discount_amount NUMERIC(15,2)   NOT NULL,       -- Actual discount applied
+    applied_at      TIMESTAMP       NOT NULL DEFAULT NOW(),
+
+    -- One voucher per booking
+    CONSTRAINT uq_voucher_booking UNIQUE (booking_id),
+    -- Prevent double-applying same voucher to same booking
+    CONSTRAINT uq_voucher_user_booking UNIQUE (voucher_id, booking_id)
+);
+
+CREATE INDEX idx_voucher_usages_voucher_id  ON voucher_usages (voucher_id);
+CREATE INDEX idx_voucher_usages_user_id     ON voucher_usages (user_id);
+CREATE INDEX idx_voucher_usages_booking_id  ON voucher_usages (booking_id);
